{
  "name": "kiilonova-trade-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Kiilonova Trade MVP — Expediente inteligente de importación (solo proponer, nunca ejecutar).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && node harness/scripts/check-secrets.mjs && node harness/scripts/check-tokens.mjs && node harness/scripts/check-feature-list.mjs",
    "db:test": "bash harness/scripts/db-test.sh"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@noble/hashes": "1.5.0",
    "decimal.js": "10.4.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/coverage-v8": "3.0.5",
    "autoprefixer": "10.4.20",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "globals": "15.14.0",
    "jsdom": "25.0.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.19.1",
    "vite": "6.0.7",
    "vitest": "3.0.5"
  }
}
