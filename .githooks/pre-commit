#!/usr/bin/env bash
# Harness control: verification before every commit (SDD § Harness de ejecución).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Creation (A) copies the principles from the approved SDD; any later modification (M/D/R) needs a person.
if git diff --cached --name-status | grep -qE '^(M|D|R[0-9]*)[[:space:]].*specs/constitution\.md' && [ "${ALLOW_CONSTITUTION_EDIT:-0}" != "1" ]; then
  echo "[harness] La constitución solo la modifica una persona. Usa ALLOW_CONSTITUTION_EDIT=1 si eres esa persona." >&2
  exit 1
fi

npm run --silent check
npm run --silent test
